# Copy to .env for a local run:  cp .env.example .env
# These are local test values only. On AWS, Terraform generates real ones.

DB_ADMIN_USER=qgadmin
DB_ADMIN_PASSWORD=local-db-admin-pass-531

SECRET_KEY=local-dev-secret-key-change-me-0123456789abcdef
ADMIN_PASSWORD=Admin@531local
ANALYST_PASSWORD=Analyst@531local

# emulated: the app blocks like AWS WAF would (local default)
# off:      nothing is blocked; use only with the unsafe demo endpoint
WAF_MODE=emulated

# Deliberately vulnerable endpoint for the controlled demo. Keep false
# unless you are showing what happens without the protections.
ENABLE_VULNERABLE_DEMO=false

# Optional read-only account (seeded only when set)
VIEWER_PASSWORD=Viewer@531local

# local | development | production (production refuses the unsafe demo and WAF_MODE=off)
APP_ENV=local
